# Local author UI: edit patterns, approve days, save to content/
NEXT_PUBLIC_BEATOBER_AUTHOR=1

# Production author API (optional; dev allows writes without this)
# BEATOBER_AUTHOR_SECRET=

# Pull from Vercel after Blob + Neon provisioning:
# npx vercel env pull .env.local
# DATABASE_URL, BLOB_STORE_ID, BEATOBER_AUTHOR_SECRET (development)
# DATABASE_URL also powers /admin/live on localhost (same Neon as production).

# Optional legacy Blob RW token (upload works via OIDC when linked)
# BLOB_READ_WRITE_TOKEN=

# Canonical URL for sitemap / OG (production)
# NEXT_PUBLIC_SITE_URL=https://studiodaze-beatober.vercel.app

# Which calendar day counts as “today” for unlocks + default day (Vercel is UTC)
# BEATOBER_TIMEZONE=America/Chicago
